# ==============================================================================
# Arachne-OS 环境变量配置模板 (.env.example)
# 复制为 .env 后即可生效；无法获取模型密钥时使用确定性离线规则，不能据此证明真实模型效果
# ==============================================================================

# --- 0. 登录与实例边界 ---
# 默认强制 Bearer 登录。新建数据库前设置自己的初始密码，请使用足够复杂的密码。
# 已有账号保留当前密码；管理员可在账号密码接口独立分配或重置密码。
ENFORCE_BEARER_AUTH=true
BOOTSTRAP_PASSWORD=
# 每个 SQLite 数据库仅支持一个后端写入进程，请勿使用 uvicorn --workers N。

# --- 1. 统一大模型路由网关 (兼容 OpenAI / DeepSeek / 本地 Ollama / vLLM) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_L2_FAST=deepseek-chat
LLM_MODEL_L3_REASONER=deepseek-reasoner
LLM_TIMEOUT_SECONDS=25.0

# --- 2. 蛛网拓扑与自我进化沙箱参数 ---
SPIDER_MAX_SPAN=5
NODE_DEHYDRATE_IDLE_SECONDS=180
SANDBOX_TIMEOUT_SECONDS=3.0
ARENA_MIN_MATCH_RATE=0.98
REPLACEABILITY_TRANSITION_THRESHOLD=90.0

# --- 3. 存储路径配置 ---
SQLITE_DB_URL=sqlite+aiosqlite:///./arachne_hot_state.db
VAULT_STORAGE_DIR=./vault_storage
SANDBOX_WORKSPACE_DIR=./sandbox_workspace

# --- 4. 企业微信可插拔传输网关 (默认 LOCAL_SIMULATOR 开箱即用) ---
# 可选值: LOCAL_SIMULATOR | WECOM_BOT_WS | WECOM_WEBHOOK
WECOM_ADAPTER_MODE=LOCAL_SIMULATOR
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_WS_ENDPOINT=wss://openws.work.weixin.qq.com
WECOM_WEBHOOK_KEY=

# --- 5. 外部业务连接器 ---
# HTTP_WEBHOOK 绑定必须配置签名密钥；外部回调还须签入匹配的 card_id 与 ticket_id。
CONNECTOR_HMAC_SECRET=
CONNECTOR_HTTP_TIMEOUT_SECONDS=5.0
CONNECTOR_MAX_RETRIES=3

